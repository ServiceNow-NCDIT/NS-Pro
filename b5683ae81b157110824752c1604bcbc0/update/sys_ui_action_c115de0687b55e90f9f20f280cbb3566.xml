        <script><![CDATA[function addNewProposedCircuit() {

    var taskSysID = g_form.getUniqueValue();

    var localCircuit = new GlideAjax('x_g_sonc_ns_pro.circuit_ajax');
    localCircuit.addParam('sysparm_name', 'createTemporaryProposedCircuit');
    localCircuit.addParam('sysparm_taskSysID', taskSysID);
    localCircuit.getXMLAnswer(getResponse);

    function getResponse(response) {
        //alert(response);
        response = JSON.parse(response);
        if (response.resultCode == "success") {
            //alert(response.message);
            g_form.addInfoMessage(response.message);
            GlideList2.get(g_form.getTableName() + '.REL:5ea9196387a95a10f9f20f280cbb358c').setFilterAndRefresh('');

        } else {
            g_form.addErrorMessage(response.message)
            return alert(response.message);
        }
    }


}]]></script>
