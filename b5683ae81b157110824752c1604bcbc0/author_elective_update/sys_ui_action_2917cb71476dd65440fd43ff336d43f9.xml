        <name>Move Selected to Pending</name>
        <onclick>confirmPortsMove()</onclick>
        <order>100</order>
        <script><![CDATA[function confirmPortsMove() {
    var answer = confirm("Move Selected Ports to Proposed?")
    if (!answer) {
        return false;
    }
    var selected = g_list.getChecked();
	
	var ports = new GlideAjax('x_g_sonc_ns_pro.port_ajax');
	ports.addParam('sysparm_name', 'moveSelectedPortsToProposed');
	ports.addParam('sysparm_selectedPorts', selected);
	ports.getXMLAnswer(getResponse);


	function getResponse(response){
		var responseObj = JSON.parse(response);
		if (responseObj.resultCode == 'success') {
			g_form.addInfoMessage(responseObj.message);
		} else {
			
			g_form.addErrorMessage(responseObj.message);
			
		}
		location.reload();
	}



 
}
]]></script>
